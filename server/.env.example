# Copy this file to .env and fill in the values. Never commit .env.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox while developing; production only after Bella says so
PLAID_ENV=sandbox

# 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

PORT=3001
